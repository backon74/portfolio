# Copy to .env.local and fill in. Never commit .env.local.
GITHUB_TOKEN=            # fine-grained PAT, public repositories read-only (GitHub widget)
RESEND_API_KEY=          # resend.com API key (Mail app)
CONTACT_TO_EMAIL=        # where contact-form messages go (must be your Resend account email)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
